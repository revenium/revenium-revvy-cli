// Revenium Metering Configuration
// Generated by Revvy
//
// Centralized helper that builds the usage metadata Revenium consumes for
// every AI call and attaches it to the context the wrapped Revenium clients
// read (github.com/revenium/revenium-go-sdk/<provider>). The wrapped client is
// created once (Initialize() returns an error, GetClient() returns the client
// and an error); every call made with a context from WithUsageMetadata carries
// the business context below.
//
// Install:
//     go get github.com/revenium/revenium-go-sdk/core@latest
//     go get github.com/revenium/revenium-go-sdk/<provider>@latest   // openai, anthropic, google, ...
//
// Required env vars (Initialize() loads .env.local and .env from the working directory):
//     REVENIUM_METERING_API_KEY=rev_mk_...
//     REVENIUM_METERING_BASE_URL=https://api.revenium.ai   (optional, default)
//     REVENIUM_WRITE_API_KEY=rev_sk_...                    (only for job outcome reporting)
package revenium

import (
	"context"

	"github.com/revenium/revenium-go-sdk/core"
)
<%_ const usedIdents = new Set() -%>
<%_ const goIdent = (prefix, name) => { const base = prefix + name.replace(/[^A-Za-z0-9]+/g, ' ').trim().split(' ').filter(Boolean).map(w => w[0].toUpperCase() + w.slice(1)).join(''); let ident = base; for (let n = 2; usedIdents.has(ident); n++) ident = base + n; usedIdents.add(ident); return ident } -%>
<%_ const goString = (value) => JSON.stringify(String(value)) -%>
<%_ const productIdents = new Map(products.map(p => [p.name, goIdent('Product', p.name)])) -%>
<%_ const agentIdents = new Map(agents.map(a => [a.name, goIdent('Agent', a.name)])) -%>
<%_ const isApiKey = organization.source === 'api-key' -%>
<%_ if (products.length > 0) { -%>

// Products detected during setup.
const (
<%_ for (const p of products) { -%>
	<%- productIdents.get(p.name) %> = <%- goString(p.name) %>
<%_ } -%>
)
<%_ } -%>
<%_ if (agents.length > 0) { -%>

// Agents detected during setup.
const (
<%_ for (const a of agents) { -%>
	<%- agentIdents.get(a.name) %> = <%- goString(a.name) %>
<%_ } -%>
)
<%_ } -%>

// Context is the business context of one AI call.
type Context struct {
<%_ if (isApiKey) { -%>
	// APIKey identifies the consumer (becomes the Revenium subscriber).
	APIKey string
<%_ } else { -%>
	// CustomerID comes from your auth context (set up as <%- (organization.customerIdExpression || 'your customer ID expression').replace(/\*\//g, '* /') %>) and wires organizationName.
	CustomerID string
<%_ } -%>
<%_ if (products.length > 0) { -%>
	// Product is which product or feature is making the call (one of the Product* constants).
	Product string
<%_ } -%>
<%_ if (agents.length > 0) { -%>
	// Agent is which agent is executing (one of the Agent* constants).
	Agent string
	// AgentVersion is the release of the agent code that made the call (max 64 chars).
	AgentVersion string
<%_ } -%>
	// TaskType is the workflow category (for example "rag-query"), not the SDK method.
	TaskType string
	// TraceID correlates the calls of one workflow run.
	TraceID string
	// AgenticJobID ties the call to a business outcome (AI Outcomes).
	AgenticJobID string
	// AgenticJobName is the human-readable Job name.
	AgenticJobName string
	// TicketID is the external ticket or issue this work belongs to (max 256 chars).
	TicketID string
	// SubagentType is the sub-agent that made the call in a multi-agent system (max 128 chars, [A-Za-z0-9._:-]).
	SubagentType string
}

// UsageMetadata builds the metadata map the Revenium Go SDK reads from the context.
func UsageMetadata(c Context) map[string]interface{} {
	metadata := map[string]interface{}{}
<%_ if (isApiKey) { -%>
	metadata["subscriber"] = map[string]interface{}{
		"id":         c.APIKey,
		"credential": map[string]interface{}{"name": "api-key", "value": c.APIKey},
	}
<%_ } else { -%>
	metadata["organizationName"] = c.CustomerID
<%_ } -%>
	set := func(key, value string) {
		if value != "" {
			metadata[key] = value
		}
	}
<%_ if (products.length > 0) { -%>
	set("productName", c.Product)
<%_ } -%>
<%_ if (agents.length > 0) { -%>
	set("agent", c.Agent)
	set("agentVersion", c.AgentVersion)
<%_ } -%>
	set("taskType", c.TaskType)
	set("traceId", c.TraceID)
	set("agenticJobId", c.AgenticJobID)
	set("agenticJobName", c.AgenticJobName)
	set("ticketId", c.TicketID)
	set("subagentType", c.SubagentType)
	return metadata
}

// WithUsageMetadata returns a context that carries the business context of
// one AI call. Pass it to the wrapped Revenium client.
func WithUsageMetadata(ctx context.Context, c Context) context.Context {
	return core.WithUsageMetadata(ctx, UsageMetadata(c))
}

